# Copy file này thành .env (file .env đã nằm trong .gitignore, KHÔNG commit lên git)
# Môi trường thật (UAT/PROD) secret lấy từ Vault, không dùng file .env
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change_me_local

# identity-service
#   ./run-local.sh (profile local): KHÔNG cần, tự sinh khóa và dùng admin mặc định.
#   docker-compose.app.yml        : BẮT BUỘC có JWT_PRIVATE_KEY + JWT_KEY_ID, thiếu thì compose báo lỗi ngay.
#   JWT_PRIVATE_KEY : private key RSA dạng PEM PKCS#8 dùng để ký access token, ghi trên MỘT dòng
#                     tạo và ghi thẳng vào .env:
#                     echo "JWT_PRIVATE_KEY=$(openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | tr -d '\n')" >> .env
#   JWT_KEY_ID      : tên khóa (kid), đổi mỗi lần xoay khóa, ví dụ 2026-11
#   BOOTSTRAP_ADMIN_USERNAME / BOOTSTRAP_ADMIN_PASSWORD : ADMIN đầu tiên, chỉ tạo khi chưa có ADMIN nào
# JWT_PRIVATE_KEY=
# JWT_KEY_ID=
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=

# Version image dùng cho docker-compose.app.yml (bỏ trống thì dùng mặc định trong file compose)
# DISCOVERY_VERSION=0.2.0
# IDENTITY_VERSION=0.1.0
# CATALOG_VERSION=0.2.0
# CUSTOMER_VERSION=0.2.0
# INVENTORY_VERSION=0.1.0
# GATEWAY_VERSION=0.2.0
